# IPsecScope — Configuration Template
# Copy this file to .env and fill in your values.
# SQLite is NOT supported. MongoDB is required (local or Atlas).

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
API_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Database — choose ONE option ──────────────────────────────────────────────
# Option A: Local MongoDB (via docker-compose `mongo` service or local install)
MONGODB_URL=mongodb://localhost:27017

# Option B: MongoDB Atlas (comment out Option A, uncomment below)
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

MONGODB_DB_NAME=ipsecscope

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_MB=200
MAX_PACKETS=2000000
ANALYSIS_TIMEOUT_S=300

# ── Worker concurrency ────────────────────────────────────────────────────────
WORKERS=2

# ── Retention ─────────────────────────────────────────────────────────────────
RETENTION_DAYS=7

# ── LLM (optional — leave LLM_PROVIDER=none to disable) ──────────────────────
LLM_PROVIDER=none
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<your-api-key>
# LLM_MODEL=llama3-8b-8192
LLM_SEND_REAL_IPS=false
