# IPsecScope Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
API_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage & Database
DATABASE_URL=sqlite:///./data/ipsecscope.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200
MAX_PACKETS=2000000
ANALYSIS_TIMEOUT_SECONDS=300

# Worker concurrency
WORKERS=2

# Retention
RETENTION_HOURS=72
